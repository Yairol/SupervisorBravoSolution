@using SupervisorBravo.Web.Models.PLC
@model PLCDeviceEditViewModel

<h2>Editar Controlador PLC</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ModbusId">Dirección Modbus</label>
        <input asp-for="ModbusId" class="form-control" type="number" />
        <span asp-validation-for="ModbusId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IpAddress">Dirección IP</label>
        <input asp-for="IpAddress" class="form-control" />
        <span asp-validation-for="IpAddress" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
