@model List<SupervisorBravo.Domain.Entities.Dixell.DixellXT>

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Parametros de Cocción-Enfriamiento.</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="CoolingCoercion" asp-action="CreateDixell" class="btn btn-success mb-3">Crear</a>
        }
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th></th>
                    <th style="background-color: yellow;">Dispositivo</th>
                    <th style="background-color: yellow;">Estado</th>
                    <th style="background-color: yellow;">SetPoint</th>
                    <th style="background-color: yellow;">Temperatura</th>
                    <th style="background-color: yellow;">Electro Válvula</th>
                    <th style="background-color: yellow;">Control</th>
                    <th style="background-color: yellow;">Último Muestreo</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                    {
                        <th style="background-color: yellow;">Editar</th>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <th style="background-color: yellow;">Eliminar</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var ultimoMuestreo = item.temperatures
                    .OrderByDescending(t => t.MeasurementTime)
                    .FirstOrDefault();

                    <tr>
                        <td>
                            <a asp-controller="CoolingCoercionChart"
                               asp-action="CoolingCoercionChart"
                               asp-route-dixellName="@item.RoomName"
                               class="btn btn-primary">
                                Graficar
                            </a>

                        </td>
                        <td>@item.RoomName</td>
                        <td>@(ultimoMuestreo?.DisconnectDixell == true ? "🔴Apagado" : "🟢Encendido")</td>
                        <td>@item.SetPoint °C</td>
                        <td>@ultimoMuestreo?.TemperatureMeasurement °C</td>
                        <td>@((ultimoMuestreo?.ControlEnable == true && item.ControlON_OFF) ? "🟢Activo" : "🔴Inactivo")</td>
                        <td>@((item.ControlON_OFF && ultimoMuestreo?.DisconnectDixell == false) ? "🟢Activo" : "🔴Inactivo")</td>
                        <td>@ultimoMuestreo?.MeasurementTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>

                        @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                        {
                            <td>
                                <a asp-controller="CoolingCoercion"
                                   asp-action="UpdateDixell"
                                   asp-route-id="@item.MoodbusId"
                                   class="btn btn-primary">
                                    Editar
                                </a>
                            </td>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                        {
                            <td>
                                <a asp-controller="CoolingCoercion"
                                   asp-action="DeleteDixell"
                                   asp-route-id="@item.MoodbusId"
                                   onclick="return confirmar()"
                                   class="btn btn-primary">
                                    Eliminar
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{
    <script>
        function confirmar()
        {
            return confirm("¿Está seguro que desea eliminar permanentemente este dixell?");
        }

        // Recargar la página cada 80 segundos (80,000 milisegundos)
        setTimeout(function () {
            location.reload();
        }, 80000);
    </script>
}
