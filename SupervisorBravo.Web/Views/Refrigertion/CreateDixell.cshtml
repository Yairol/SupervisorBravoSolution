@{
}
@model SupervisorBravo.Domain.Entities.Dixell.DixellXR;

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Crear nuevo DixellXR</h2>
        <form asp-controller="Refrigertion" asp-action="CreateDixell" method="post">
            <div class="mb-3">
                <label>Nombre de la sala.</label>
                <input class="form-control" asp-for="RoomName" type="text" required/>
                <span asp-validation-for="RoomName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Identificador en el bus modbus.</label>
                <input class="form-control" asp-for="MoodbusId" type="number" required/>
                <span asp-validation-for="MoodbusId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-controller="Refrigertion" asp-action="Dixells" class="btn btn-warning">Volver</a>
            </div>
        </form>
    </div>
</div>