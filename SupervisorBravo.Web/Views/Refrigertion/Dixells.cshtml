@model List<SupervisorBravo.Domain.Entities.Dixell.DixellXR>

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Parámetros de Refrigeración.</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Refrigertion" asp-action="CreateDixell" class="btn btn-success mb-3">Crear</a>
        }

        <table class="table table-bordered border border-dark">
            <thead class="text-center align-middle">
                <tr>
                    <th></th>
                    <th style="background-color: yellow;">Dispositivo</th>
                    <th style="background-color: yellow;">Estado</th>
                    <th style="background-color: yellow;">SetPoint</th>
                    <th style="background-color: yellow;">Temperatura</th>
                    <th style="background-color: yellow;">Enfriamiento</th>
                    <th style="background-color: yellow;">Descongelar</th>
                    <th style="background-color: yellow;">Ventilador</th>
                    <th style="background-color: yellow;">On/Off</th>
                    <th style="background-color: yellow;">Último Muestreo</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                    {
                        <th style="background-color: yellow;">Editar</th>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <th style="background-color: yellow;">Eliminar</th>
                    }
                </tr>
            </thead>
            <tbody class="text-center align-middle">
                @foreach (var item in Model)
                {
                    var ultimoMuestreo = item.temperatures
                    .OrderByDescending(t => t.MeasurementTime)
                    .FirstOrDefault();

                    <tr>
                        <td>
                            <a asp-controller="RefrigerationChart"
                               asp-action="RefrigerationChart"
                               asp-route-dixellName="@item.RoomName"
                               class="btn btn-primary">
                                Graficar
                            </a>

                        </td>
                        <td>@item.RoomName</td> @*NOMBRE DEL DISPOSITIVO*@
                        <td>@(ultimoMuestreo?.DisconnectDixell == true ? "🔴Apagado" : "🟢Encendido")</td> @*CONEXION/DESCONEXION*@
                        <td>@item.SetPoint °C</td> @*SETPOINT*@
                        <td>@ultimoMuestreo?.TemperatureMeasurement °C</td> @*TEMPERATURA*@
                        <td>@((ultimoMuestreo?.ControlEnable == true && item.ControlON_OFF && !item.Thawing) ? "🟢Activo" : "🔴Inactivo")</td>@*ENFRIAMIENTO*@
                        <td>@((item.Thawing && item.ControlON_OFF) ? "🟢Activo" : "🔴Inactivo")</td>@*DEFROST*@
                        <td>@((item.ControlON_OFF && item.ControlON_OFF) ? "🟢Activo" : "🔴Inactivo")</td>@*VENTILADOR*@
                        <td>@((item.ControlON_OFF && ultimoMuestreo?.TemperatureMeasurement != 0) ? "🟢Activo" : "🔴Inactivo")</td>@*CONTROL*@
                        <td>@ultimoMuestreo?.MeasurementTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>@*ULTIMO MUESTREO*@

                        @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                        {
                            <td>
                                <a asp-controller="Refrigertion"
                                   asp-action="UpdateDixell"
                                   asp-route-id="@item.MoodbusId"
                                   class="btn btn-primary">
                                    Editar
                                </a>
                            </td>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                        {
                            <td>
                                <a asp-controller="Refrigertion"
                                   asp-action="DeleteDixell"
                                   asp-route-id="@item.MoodbusId"
                                   onclick="return confirmar()"
                                   class="btn btn-primary">
                                    Eliminar
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{
    <script>
        function confirmar() {
            return confirm("¿Está seguro que desea eliminar permanentemente este dixell?");
        }

        // Recargar la página cada 80 segundos
        setTimeout(function () {
            location.reload();
        }, 80000);
    </script>
}
