    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<SupervisorBravo.Domain.Entities.Dixell.DixellXR60CX>

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Parametros de Refrigeracion.</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Refrigertion" asp-action="CreateDixell" class="btn btn-success mb-3">Crear</a>
        }

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Dispositivo</th>
                    <th>On/Off</th>
                    <th>SetPoint</th>
                    <th>Temperatura</th>
                    <th>Enfriamiento</th>
                    <th>Descongelar</th>
                    <th>Ventilador</th>
                    <th>Último Muestreo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.RoomName</td>
                        <td>@((item.ControlON_OFF) ? "⚡Activo" : "🔴Inactivo")</td>
                        <td>@item.SetPoint °C</td>
                        <td>@item.temperatures.OrderByDescending(t => t.MeasurementTime).FirstOrDefault()?.TemperatureMeasurement °C</td>
                        <td>@((item.temperatures.OrderByDescending(t => t.MeasurementTime).FirstOrDefault()?.TemperatureMeasurement > item.SetPoint && item.ControlON_OFF == true && item.Thawing == false) ? "⚡Activo" : "🔴Inactivo")</td>
                        <td>@((item.Thawing && item.ControlON_OFF) ? "⚡Activo" : "🔴Inactivo")</td>
                        <td>@((item.temperatures.OrderByDescending(t => t.MeasurementTime).FirstOrDefault()?.TemperatureMeasurement > item.SetPoint && item.ControlON_OFF == true && item.Thawing == false) ? "⚡Activo" : "🔴Inactivo")</td>
                        <td>@item.temperatures.LastOrDefault()?.MeasurementTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                        {
                            <td>
                                <a asp-controller="Refrigertion"
                                asp-action="UpdateDixell"
                                asp-route-id="@item.MoodbusId"
                                class="btn btn-primary">
                                    Editar
                                </a>

                            </td>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <a asp-controller="Refrigertion"
                                asp-action="DeleteDixell"
                                asp-route-id="@item.MoodbusId"
                                onclick="return confirmar()"
                                class="btn btn-primary">
                                    Eliminar
                                </a>
                            </td>
                        }

                    </tr>
                }
        </table>
    </div>
</div>

@section Scripts
{
    <script>
        function confirmar()
        {
            return confirm("¿Esta seguro que desea eliminar permanentemente este dixell?")
        }
    </script>
}