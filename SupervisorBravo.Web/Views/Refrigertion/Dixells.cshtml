@{
}
@model List<SupervisorBravo.Domain.Entities.Dixell.DixellXR60CX>

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Parametros de Refrigeracion.</h2>
        <a asp-controller="Refrigertion" asp-action="CreateDixell" class="btn btn-success mb-3">Crear</a>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Dispositivo</th>
                    <th>On/Off</th>
                    <th>SetPoint</th>
                    <th>Temperatura</th>
                    <th>Cooling</th>
                    <th>Defrost</th>
                    <th>Fan</th>
                    <th>Último Muestreo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.RoomName</td>
                        <td>@item.ControlON_OFF</td>
                        <td>@item.SetPoint °C</td>
                        <td>@item.temperatures.OrderByDescending(t => t.MeasurementTime).FirstOrDefault()?.TemperatureMeasurement °C</td>
                        <td>@(item.Thawing ? "🔴Inactivo" : "⚡Activo")</td>
                        <td>@(item.Thawing ? "⚡Activo" : "🔴Inactivo")</td>
                        <td>@(item.Thawing ? "🔴Inactivo" : "⚡Activo")</td>
                        <td>@item.temperatures.LastOrDefault()?.MeasurementTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            <a asp-controller="Refrigertion"
                                asp-action="UpdateDixell"
                                asp-route-id ="@item.MoodbusId"
                                class="btn btn-primary">Editar
                            </a>

                        </td>
                        <td>
                            <a asp-controller="Refrigertion"
                               asp-action="DeleteDixell"
                               asp-route-id="@item.MoodbusId"
                               onclick="return confirmar()"
                               class="btn btn-primary">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
        </table>
    </div>
</div>

@section Scripts
{
    <script>
        function confirmar()
        {
            return confirm("¿Esta seguro que desea eliminar permanentemente este dixell?")
        }
    </script>
}