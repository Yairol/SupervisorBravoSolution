@{
}
@model SupervisorBravo.Domain.Entities.Dixell.DixellXR60CX;

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Editar DixellXR</h2>
        <form asp-controller="Refrigertion" asp-action="UpdateDixell" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label>Nombre de la sala.</label>
                <input class="form-control" asp-for="RoomName" type="text" />
            </div>
            <div class="mb-3">
                <label>Identificador en el bus modbus.</label>
                <input class="form-control" asp-for="MoodbusId" type="number" />
            </div>
            <div class="mb-3">
                <label>SetPoint.</label>
                <input class="form-control" asp-for="SetPoint" type="number" />
            </div>
            <div class="mb-3">
                <input class="form-check-input" asp-for="ControlON_OFF" type="checkbox" id="chkControlON_OFF" />
                <label class="form-check-label" for="chkControlON_OFF">ControlON_OFF</label>

            </div>
            <div class="mb-3">
               
                <input class="form-check-input" asp-for="Thawing" type="checkbox" id="chkThawing" />
                <label class="form-check-label" for="chkThawing">Thawing</label>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Actulizar</button>
                <a asp-controller="Refrigertion" asp-action="Dixells" class="btn btn-warning">Volver</a>
            </div>
        </form>
    </div>
</div>