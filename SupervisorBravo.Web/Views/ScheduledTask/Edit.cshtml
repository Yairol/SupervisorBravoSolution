@using SupervisorBravo.Domain.Entities.Schedule
@model ScheduleTaskViewModel

<h2>✏️ Editar Tarea Programada</h2>

<form asp-controller="ScheduledTask" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="SelectedDeviceId" class="form-label">Dispositivo</label>
        <select asp-for="SelectedDeviceId" asp-items="Model.Devices" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="SelectedAction" class="form-label">Acción</label>
        <select asp-for="SelectedAction" asp-items="Model.ActionOptions" class="form-select" id="accionDropdown"></select>
    </div>

    <div class="mb-3" id="setPointContainer">
        <label asp-for="SetPointValue" class="form-label">Set Point</label>
        <input asp-for="SetPointValue" class="form-control" />
        <span asp-validation-for="SetPointValue" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ScheduledDateTime" class="form-label">Fecha/Hora</label>
        <input asp-for="ScheduledDateTime" class="form-control" type="datetime-local" />
        <span asp-validation-for="ScheduledDateTime" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsRecurring" type="checkbox" class="form-check-input" id="IsRecurring" />
        <label asp-for="IsRecurring" class="form-check-label">¿Cíclica?</label>
    </div>

    <div id="recurrenceGroup" style="display:none;">
        <div class="mb-3">
            <label asp-for="Recurrence" class="form-label">Tipo de recurrencia</label>
            <select asp-for="Recurrence" class="form-select">
                <option value="">Seleccione...</option>
                <option value="Daily">Diario</option>
                <option value="Weekly">Semanal</option>
                <option value="Monthly">Mensual</option>
            </select>
            <span asp-validation-for="Recurrence" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RecurrenceEndDate" class="form-label">Fecha Fin de Ciclo</label>
            <input asp-for="RecurrenceEndDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="RecurrenceEndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Estado de la tarea</label>
        <select asp-for="Status" class="form-select">
            @foreach (var status in Enum.GetValues(typeof(ScheduledTaskStatus)))
            {
                <option value="@status">@status</option>
            }
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <script>
        function toggleSetPoint() {
            const action = document.getElementById("accionDropdown").value;
            document.getElementById("setPointContainer").style.display =
                action === "ChangeSetPoint" ? "block" : "none";
        }

        function toggleRecurrenceOptions() {
            const isRecurring = document.getElementById("IsRecurring").checked;
            document.getElementById("recurrenceGroup").style.display = isRecurring ? "block" : "none";
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleSetPoint();
            toggleRecurrenceOptions();

            document.getElementById("accionDropdown").addEventListener("change", toggleSetPoint);
            document.getElementById("IsRecurring").addEventListener("change", toggleRecurrenceOptions);
        });
    </script>
}
