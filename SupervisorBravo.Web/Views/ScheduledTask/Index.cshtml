@using SupervisorBravo.Domain.Entities.Schedule
@model ScheduledTaskListFilterViewModel

<h2 class="mb-3 text-center">📋 Tareas Programadas</h2>

<!-- 🔍 Filtros -->
<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label>📟 Dispositivo</label>
            <select name="deviceName" class="form-select">
                <option value="">Todos</option>
                @foreach (var d in Model.AvailableDeviceNames)

                {
                    <option value="@d" selected="@(Model.SelectedDeviceName == d)">@d</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>🛠 Acción</label>
            <select name="action" class="form-select">
                <option value="">Todas</option>
                @foreach (var a in Model.AvailableActions)

                {
                    <option value="@a" selected="@(Model.SelectedAction == a)">@a</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label>📌 Estado</label>
            <select name="status" class="form-select">
                <option value="">Todos</option>
                @foreach (var s in Model.AvailableStatuses)

                {
                    <option value="@s" selected="@(Model.SelectedStatus == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-primary">🔍 Filtrar</button>
        </div>
    </div>
</form>

<!-- 🧾 Tabla de tareas -->
<table class="table table-bordered table-striped">
    <thead class="table-dark text-center align-middle">
        <tr>
            <th>Dispositivo</th>
            <th>Acción</th>
            <th>Fecha/Hora</th>
            <th>¿Cíclica?</th>
            <th>Estado</th>
            @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
            {
                <th>Editar</th>
            }
            @if (User.IsInRole("Admin"))
            {
                <th>Eliminar</th>
            }
        </tr>
    </thead>
    <tbody class="text-center align-middle">
        @foreach (var item in Model.Items)

        {
            <tr>
                <td>@item.DeviceName</td>
                <td>
                    @{
                        var accionTraducida = item.Action switch
                        {

                            ActionType.TurnOn => "Encender",

                            ActionType.TurnOff => "Apagar",

                            ActionType.ChangeSetPoint when item.SetPointValue.HasValue =>

                            $"Cambiar Set Point → {item.SetPointValue.Value}°C",

                            ActionType.ChangeSetPoint => "Cambiar Set Point",

                            _ => item.Action.ToString()
                        };
                    }
                    @accionTraducida
                </td>
                <td>@item.ScheduledDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <span class="badge @(item.IsRecurring ? "bg-success" : "bg-secondary")">
                        @(item.IsRecurring ? "Sí" : "No")
                    </span>
                </td>
                <td>
                    <span class="badge bg-info text-dark">@item.Status</span>
                </td>
                @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))

                {
                    <td>
                        <a asp-controller="ScheduledTask" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-fill"></i> Editar
                        </a>
                    </td>
                }
                @if (User.IsInRole("Admin"))

                {
                    <td>
                        <form asp-controller="ScheduledTask" asp-action="Delete" asp-route-id="@item.Id"
                              method="post" onsubmit="return confirmar();" class="d-inline">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-trash-fill"></i> Eliminar
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<!-- ⏱ Paginación -->
<nav aria-label="Paginación de tareas">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new {
                page = Model.CurrentPage - 1,
                deviceName = Model.SelectedDeviceName,
                action = Model.SelectedAction,
                status = Model.SelectedStatus
            })">⏪ Anterior</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Página @Model.CurrentPage de @Model.TotalPages</span>
        </li>
        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new {
                page = Model.CurrentPage + 1,
                deviceName = Model.SelectedDeviceName,
                action = Model.SelectedAction,
                status = Model.SelectedStatus
            })">Siguiente ⏩</a>
        </li>
    </ul>
</nav>

@section Scripts {
    <script>
        function confirmar() {
            return confirm("¿Está seguro que desea eliminar permanentemente esta tarea programada?");
        }
    </script>
}
