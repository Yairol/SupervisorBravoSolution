@model SupervisorBravo.Web.Models.DTOs.AlarmModel

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Estado del Sistema</h2>
        <div class="d-flex justify-content-between mb-3">
            <a asp-controller="Alarm" asp-action="DeleteAllAlarms" 
               onclick="return confirmar()"
               class="btn btn-primary">
                Eliminar Todas
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="DataAnalyses" asp-action="Index"
                   class="btn btn-success">
                    Análisis de Datos
                </a>
            }
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th style="background-color: yellow;">Nombre</th>
                    <th style="background-color: yellow;">Descripcion</th>
                    <th style="background-color: yellow;">Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Alarms)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.AlarmDate.ToLocalTime()</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <a asp-controller="Alarm"
                                   asp-action="DeleteAlarm"
                                   asp-route-id="@item.Id"
                                   onclick="return confirmar()"
                                   class="btn btn-primary">
                                    Eliminar
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <h2>Estado de los Dispositivos</h2>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th style="background-color: yellow;">Nombre</th>
                    <th style="background-color: yellow;">Dispositivo</th>
                    <th style="background-color: yellow;">Descripcion</th>
                    <th style="background-color: yellow;">Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.DeviceAlarms)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.DeviceName</td>
                        <td>@item.Description</td>
                        <td>@item.AlarmDate.ToLocalTime()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{
    <script>
        function confirmar()
        {
            return confirm("¿Está seguro que desea eliminar permanentemente todas las alarmas?")
        }
    </script>
}
